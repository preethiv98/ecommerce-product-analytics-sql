    <worksheet name='Revenue by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Revenue by product category - Oct-Nov 2019</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='product_performance_summary (ecommerce_project)' name='federated.1b2jvw709t4kv2136p7p211njfe8' />
          </datasources>
          <datasource-dependencies datasource='federated.1b2jvw709t4kv2136p7p211njfe8'>
            <column caption='New Category' datatype='string' name='[category_label]' role='dimension' type='nominal' />
            <column caption='Gross Revenue' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[gross_revenue]' role='measure' type='quantitative' />
            <column-instance column='[category_label]' derivation='None' name='[none:category_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_date]' derivation='None' name='[none:session_date:qk]' pivot='key' type='quantitative' />
            <column caption='Product Type' datatype='string' name='[product_type]' role='dimension' type='nominal' />
            <column caption='Session Date' datatype='date' name='[session_date]' role='dimension' type='ordinal' />
            <column-instance column='[gross_revenue]' derivation='Sum' name='[sum:gross_revenue:qk]' pivot='key' type='quantitative' />
