      <column caption='Revenue Floor' datatype='integer' name='[Calculation_1085556555014144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR(SUM([gross_revenue]) / 100000) * 100000' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_1643353252655104]' role='measure' type='quantitative'>
