    <worksheet name='KPI Conversion'>
      <table>
        <view>
          <datasources>
            <datasource caption='product_performance_summary (ecommerce_project)' name='federated.1b2jvw709t4kv2136p7p211njfe8' />
          </datasources>
          <datasource-dependencies datasource='federated.1b2jvw709t4kv2136p7p211njfe8'>
            <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_1643353252655104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([purchases_count]) / SUM([views_count])' />
            </column>
            <column caption='Product Type' datatype='string' name='[product_type]' role='dimension' type='nominal' />
            <column caption='Purchases Count' datatype='integer' name='[purchases_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1643353252655104]' derivation='User' name='[usr:Calculation_1643353252655104:qk]' pivot='key' type='quantitative' />
            <column caption='Views Count' datatype='integer' name='[views_count]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1b2jvw709t4kv2136p7p211njfe8].[Action (Product Type)]'>
            <groupfilter function='member' level='[product_type]' member='&quot;Home &amp; Personal Appliances&quot;' user:ui-action-filter='[Action1_E84027D72A70402BA869DB9CA4625618]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1b2jvw709t4kv2136p7p211njfe8].[Action (Product Type)]</column>
          </slices>
          <aggregation value='true' />
